---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import About from "../components/About.astro";
import Signature from "../components/Signature.astro";
import Menu from "../components/Menu.astro";
import Gallery from "../components/Gallery.astro";
import Info from "../components/Info.astro";
import Access from "../components/Access.astro";
import Contact from "../components/Contact.astro";
import { menu, site } from "../data/site";

const pageUrl = `${site.url}/`;
const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

function offersFrom(price: string) {
  const amounts = [...price.replaceAll(",", "").matchAll(/¥(\d+)/g)].map((match) => match[1]);
  if (amounts.length === 0) return {};
  const offers = amounts.map((amount) => ({
    "@type": "Offer",
    price: amount,
    priceCurrency: "JPY",
  }));
  return { offers: offers.length === 1 ? offers[0] : offers };
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${pageUrl}#website`,
      url: pageUrl,
      name: site.name,
      inLanguage: "ja",
    },
    {
      "@type": "Restaurant",
      "@id": `${pageUrl}#restaurant`,
      name: site.name,
      alternateName: ["ジヤ", "Jiya"],
      description: site.description,
      url: pageUrl,
      image: `${site.url}/ogp.jpg`,
      telephone: "+81-29-229-1755",
      servesCuisine: ["Indian", "Chinese"],
      priceRange: "¥¥",
      address: {
        "@type": "PostalAddress",
        postalCode: "311-1246",
        addressRegion: "茨城県",
        addressLocality: "ひたちなか市",
        streetAddress: "相金町1-5",
        addressCountry: "JP",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      hasMap: site.mapUrl,
      sameAs: [site.mapUrl, site.tabelogUrl],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: weekdays,
          opens: "11:00",
          closes: "15:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: weekdays,
          opens: "17:00",
          closes: "22:00",
        },
      ],
      acceptsReservations: true,
      menu: `${pageUrl}#menu-list`,
      hasMenu: {
        "@type": "Menu",
        name: "お品書き",
        hasMenuSection: menu.map((category) => ({
          "@type": "MenuSection",
          name: category.ja,
          ...(category.note ? { description: category.note } : {}),
          hasMenuItem: category.items.map((item) => ({
            "@type": "MenuItem",
            name: item.name,
            ...(item.desc ? { description: item.desc } : {}),
            ...offersFrom(item.price),
          })),
        })),
      },
      potentialAction: {
        "@type": "ReserveAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: site.reserveUrl,
          inLanguage: "ja",
          actionPlatform: [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform",
          ],
        },
      },
    },
  ],
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Marquee />
  <About />
  <Signature />
  <Menu />
  <Gallery />
  <Info />
  <Access />
  <Contact />
</Base>
